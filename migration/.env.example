# Notion integration token (Settings > Connections > Develop or manage integrations)
NOTION_API_KEY=secret_xxx

# Notion database ID (32-char id from the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: skip the database->data source lookup by setting this directly
# NOTION_DATA_SOURCE_ID=

# Only needed for `npm run migrate wix-api`
WIX_API_KEY=
WIX_SITE_ID=
