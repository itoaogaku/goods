{
  "name": "wix-to-notion-migration",
  "version": "1.0.0",
  "private": true,
  "description": "Wix Stores の販売データ(CSVエクスポート)をNotionデータベースへ移行するCLIツール",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "commander": "^14.0.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
