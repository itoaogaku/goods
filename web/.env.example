# Notion integration token (Settings > Connections > Develop or manage integrations)
NOTION_API_KEY=secret_xxx

# Notion database ID (32-char id from the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Earliest sale date to include in aggregation (YYYY-MM-DD)
SALES_DATA_SINCE=2025-03-01

# Comma-separated list of origins allowed to call the API from a browser.
# Leave unset only for local development (defaults to "*").
ALLOWED_ORIGIN=https://your-dashboard.vercel.app
