# Notion integration token (shared by both ledgers — connect it to both databases)
NOTION_API_KEY=secret_xxx

# Athlete Career Center (ACC) ledger: 水上村・町田寮 stock & sales database
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATA_SOURCE_ID=   # optional: skip the database->data source lookup

# 陸上部 (track team) ledger: its own, separate database
TRACK_TEAM_NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRACK_TEAM_NOTION_DATA_SOURCE_ID=   # optional

# 料金表一覧 (price list): a single shared database, not per-ledger — see
# "料金表一覧（Wix商品カタログの自動取り込み）" in README.md for its schema
NOTION_PRODUCTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_PRODUCTS_DATA_SOURCE_ID=   # optional

# Earliest date included in sales KPIs/reporting (YYYY-MM-DD). Does not
# affect stock balances, which are always computed from full history.
SALES_DATA_SINCE=2025-03-01

# Comma-separated list of origins allowed to call the API from a browser.
# Leave unset only for local development (defaults to "*").
ALLOWED_ORIGIN=https://your-dashboard.vercel.app

# --- Wix -> ACC ledger automatic sync (app/api/acc/sync-wix, vercel.json cron) ---
# Wix API key with Orders read access, and the site ID. Same values used by
# ../migration for the one-time historical CSV/API import.
WIX_API_KEY=
WIX_SITE_ID=
# Stock location Wix orders are recorded against (default: 水上村)
# WIX_SYNC_LOCATION=水上村
# Only sync orders from this date onward (default: SALES_DATA_SINCE)
# WIX_SYNC_SINCE=2025-03-01

# --- アプリ全体のパスワード保護 (proxy.ts, app/login) ---
# 設定すると、パスワードだけを尋ねる専用のログイン画面(/login)がアプリ
# 全体にかかる。未設定の間は誰でもアクセスできる。本番(Vercel)には
# 必ず設定すること。
APP_PASSWORD=

# Vercel Cronが日次のWix同期(app/api/acc/sync-wix)を呼ぶ際、上のAPP_PASSWORD
# 保護をすり抜けて直接叩けてしまうのを防ぐための合言葉。Vercelの
# 環境変数にCRON_SECRETという名前で設定すると、Vercelがcronリクエストに
# 自動でAuthorization: Bearer <CRON_SECRET> を付けてくれる（値はVercel側の
# 仕組みとして予約されている変数名なので、名前を変えないこと）。未設定の
# 間はこのチェック自体が行われない。
# CRON_SECRET=
